# Elasticsearch-Endpunkt des Archivs für Agrargeschichte
AFA_ES_URL=https://agrargeschichte.pansoft.de:9210/*/_search

# Transport: streamable-http | stdio
MCP_TRANSPORT=streamable-http

# HTTP-Server
HOST=127.0.0.1
PORT=8766

# Pfad-Präfix für die MCP-Endpunkte (Default /mcp)
MCP_PATH=/mcp

# Öffentliche Basis-URL für Server Card und .well-known-Endpunkte
PUBLIC_BASE_URL=https://mcp.histoirerurale.ch

# Streamable HTTP ohne serverseitige Session-Pflicht
MCP_STATELESS_HTTP=true

# JSON-Response-Modus für POST /mcp (akzeptiert Clients mit nur application/json)
MCP_JSON_RESPONSE=true

# DNS-Rebinding-Schutz
MCP_DNS_REBINDING_PROTECTION=true
# MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS=

# Loglevel (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Request-Timeout für die Elasticsearch-Anfragen in Sekunden
HTTP_TIMEOUT=30

# TLS-Zertifikatsprüfung für den Elasticsearch-Upstream
AFA_VERIFY_SSL=true

# CORS
CORS_ALLOW_ORIGINS=*

# JSON-RPC Access-Log (Nutzungsstatistik)
# Aktiviert die ASGI-Middleware, die jede MCP-Methode/Tool-Aufruf einzeln loggt.
AFA_ACCESS_LOG=true
# Maximale Zeichen pro args-Repräsentation in der Logzeile (Default 200).
AFA_ACCESS_LOG_ARGS_MAX=200
# Optional: dedizierte Logdatei. Ohne Angabe geht alles in stdout (= nohup-Logfile).
# AFA_ACCESS_LOG_FILE=/home/joern/afa-mcp/access.log

# Statistik-Seite (/statistik) — JSON-Cache fuer Vortage, Live fuer heute.
# AFA_STATS_CACHE=/home/joern/afa-mcp/stats-cache.json
# Basic Auth: setze BEIDE, sonst ist /statistik offen.
# AFA_STATS_USER=admin
# AFA_STATS_PASS=CHANGEME
