# Elasticsearch-Endpunkt des Archivs für Agrargeschichte
AFA_ES_URL=https://agrargeschichte.pansoft.de:9210/*/_search

# Transport: streamable-http | stdio
MCP_TRANSPORT=streamable-http

# HTTP-Server
HOST=127.0.0.1
PORT=8766

# Pfad-Präfix für die MCP-Endpunkte (Default /mcp)
MCP_PATH=/mcp

# Öffentliche Basis-URL für Server Card und .well-known-Endpunkte
PUBLIC_BASE_URL=https://mcp.histoirerurale.ch

# Streamable HTTP ohne serverseitige Session-Pflicht
MCP_STATELESS_HTTP=true

# JSON-Response-Modus für POST /mcp (akzeptiert Clients mit nur application/json)
MCP_JSON_RESPONSE=true

# DNS-Rebinding-Schutz
MCP_DNS_REBINDING_PROTECTION=true
# MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS=

# Loglevel (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Request-Timeout für die Elasticsearch-Anfragen in Sekunden
HTTP_TIMEOUT=30

# TLS-Zertifikatsprüfung für den Elasticsearch-Upstream
AFA_VERIFY_SSL=true

# CORS
CORS_ALLOW_ORIGINS=*
